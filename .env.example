# Kakao Maps API Keys
# Get your API keys from: https://developers.kakao.com/
# 1. JavaScript 키 (지도 표시용)
VITE_KAKAO_API_KEY=YOUR_KAKAO_JAVASCRIPT_KEY_HERE
# 2. REST API 키 (장소 검색, 경로 탐색용)
VITE_KAKAO_REST_API_KEY=YOUR_KAKAO_REST_API_KEY_HERE

# Optional: For production deployment
# VITE_API_BASE_URL=https://api.yourdomain.com
